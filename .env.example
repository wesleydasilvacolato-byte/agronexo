# Preencha SOMENTE no painel da Vercel, nunca publique a chave no GitHub.
# Gemini API (Google AI Studio), sujeito aos termos e cotas do Google.
GEMINI_API_KEY=
# Opcional; modelo atual recomendado para uso multimodal:
GEMINI_MODEL=gemini-3.5-flash-lite

# Proteção opcional com limite compartilhado entre funções (Upstash Redis).
# Obrigatória antes da abertura a um grande número de usuários.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Autenticação e painel administrativo (Supabase) ===
# Criadas em Supabase > Project Settings > API / API Keys
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 32 bytes aleatórios em base64. NÃO use um texto fácil nem publique seu valor.
AUTH_SESSION_SECRET=
# Somente para script manual de inicialização (nunca expor ao browser)
ADMIN_EMAIL=wesledasilvacolato@gmail.com
ADMIN_INITIAL_PASSWORD=
