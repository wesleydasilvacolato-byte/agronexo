{
  "version": 2,
  "functions": {
    "api/bulario.js": {
      "maxDuration": 60,
      "includeFiles": "data/agrofit/**"
    },
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/transcribe.js": {
      "maxDuration": 60
    },
    "api/bula.js": {
      "maxDuration": 60
    },
    "api/status.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache",
          "source": null
        }
      ]
    }
  ],
  "framework": null,
  "buildCommand": "npm run build"
}
