{
  "name": "agronexo",
  "version": "1.6.0-beta",
  "private": true,
  "type": "module",
  "description": "Plataforma de apoio agronômico",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "vercel dev",
    "build": "npm test && node scripts/build-agrofit.mjs && npm run test:index && node scripts/invite-once.mjs && node scripts/reset-admin-password-once.mjs",
    "test": "node --test tests/calculators.test.mjs tests/frontend-smoke.test.mjs tests/auth-pwa.test.mjs",
    "test:index": "node --test tests/agrofit-index.test.mjs",
    "test:security": "node --test tests/security.test.mjs tests/mobile.test.mjs tests/auth-pwa.test.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "sharp": "^0.34.3"
  }
}
